# Optional overrides.
# DATASIGHT_MAX_UPLOAD_BYTES=104857600
# DATASIGHT_DATASET_TTL_SECONDS=3600
# DATASIGHT_MAX_DATASETS=100
# DATASIGHT_MAX_STORE_BYTES=1073741824
# DATASIGHT_MAX_CONCURRENT_JOBS=2
# DATASIGHT_MAX_WORKBOOK_BYTES=134217728
# DATASIGHT_MAX_USER_STORE_BYTES=268435456
# DATASIGHT_MAX_DATASETS_PER_USER=20
# DATASIGHT_DASHBOARD_CACHE_SIZE=16
# DATASIGHT_DATABASE_PATH=datasight.db
# DATASIGHT_SESSION_TTL_SECONDS=604800
# DATASIGHT_SECURE_COOKIES=false
# Signing in with Google; see the README. The redirect URI below must be listed
# in the OAuth client exactly as written.
# DATASIGHT_GOOGLE_CLIENT_ID=
# DATASIGHT_GOOGLE_CLIENT_SECRET=
# DATASIGHT_GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# Signing in with GitHub; see the README. The OAuth app's callback URL must be
# the redirect URI below.
# DATASIGHT_GITHUB_CLIENT_ID=
# DATASIGHT_GITHUB_CLIENT_SECRET=
# DATASIGHT_GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback
# DATASIGHT_APP_URL=http://localhost:3000
# DATASIGHT_API_DOCS=true
