{
	# rate_limit is a plugin, so Caddy needs to be told where it runs: early, before
	# anything else handles the request. (basic_auth is only a position in Caddy's
	# directive order here; the site signs people in with its own accounts.)
	order rate_limit before basic_auth

	servers {
		timeouts {
			read_header 10s
			read_body 2m
			write 3m
			idle 2m
		}
	}
}

# Caddy obtains and renews the HTTPS certificate for this domain automatically.
# The domain's DNS must point at this server, with ports 80 and 443 open.
{$DATASIGHT_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Next.js injects inline scripts and Plotly injects inline styles.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# Sign-up and log-in are where passwords are guessed and accounts mass-created,
	# so they get a far tighter limit than the rest of the API, as does each sign-in
	# at Google or GitHub. /api/auth/me is asked on every page load and stays out.
	handle /api/auth/* {
		@credentials path /api/auth/login /api/auth/signup /api/auth/google/* /api/auth/github/*
		rate_limit @credentials {
			zone accounts {
				key {remote_host}
				events 10
				window 1m
			}
		}
		request_body {
			max_size 16KB
		}
		reverse_proxy backend:8000
	}

	handle /api/upload {
		rate_limit {
			zone uploads {
				key {remote_host}
				events 10
				window 1m
			}
		}
		# Rejects oversized uploads here, before the backend spools them to disk.
		request_body {
			max_size {$DATASIGHT_PROXY_MAX_UPLOAD}
		}
		reverse_proxy backend:8000 {
			transport http {
				response_header_timeout 2m
			}
		}
	}

	handle /api/* {
		rate_limit {
			zone api {
				key {remote_host}
				events 300
				window 1m
			}
		}
		request_body {
			max_size 1MB
		}
		reverse_proxy backend:8000 {
			transport http {
				response_header_timeout 2m
			}
		}
	}

	handle {
		request_body {
			max_size 1MB
		}
		reverse_proxy frontend:3000
	}
}
