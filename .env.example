# Settings for the production stack in compose.yaml. Copy to .env and fill in.

# The public domain. Its DNS must point at this server.
DATASIGHT_DOMAIN=datasight.example.com

# The shared login in front of the whole site. Generate the hash with:
#   docker run --rm caddy:2 caddy hash-password
# Keep the single quotes: the hash contains $ characters.
DATASIGHT_USER=datasight
DATASIGHT_PASSWORD_HASH='$2a$14$replace.with.the.output.of.caddy.hash-password'

# Optional limits. Size these to the server's RAM: datasets are held in memory.
# DATASIGHT_MAX_UPLOAD_BYTES=26214400
# DATASIGHT_PROXY_MAX_UPLOAD=26MiB
# DATASIGHT_MAX_DATASETS=40
# DATASIGHT_DATASET_TTL_SECONDS=3600
# DATASIGHT_BACKEND_MEMORY=2g
